{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "eventra-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/eventra-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["node_modules/bootstrap/dist/css/bootstrap.min.css", "node_modules/bootstrap-icons/font/bootstrap-icons.min.css", "node_modules/@fontsource/plus-jakarta-sans/400.css", "node_modules/@fontsource/plus-jakarta-sans/500.css", "node_modules/@fontsource/plus-jakarta-sans/600.css", "node_modules/@fontsource/plus-jakarta-sans/700.css", "node_modules/@fontsource/fraunces/500.css", "node_modules/@fontsource/fraunces/600.css", "node_modules/@fontsource/fraunces/500-italic.css", "src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "eventra-frontend:build:production" },
            "development": { "buildTarget": "eventra-frontend:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "e3f77428-f819-4a9b-835a-e83a7c1e080f"
  }
}
